# Copy to .env (or set these as environment variables on the server). Never commit .env.

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Stripe secret TEST key (sk_test_...): Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=

# Public address of this site, used for the Stripe return links (no trailing slash)
BASE_URL=http://localhost:3000

# Optional:
# PORT=3000
# DB_PATH=data/advisor.db
# NODE_ENV=production

# Email (SMTP) for booking confirmations, e.g. from your email provider or Mailtrap.
# SMTP_PORT: 587 (STARTTLS) or 465 (TLS). SMTP_FROM: the address emails are sent from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Password for the staff page at /desk (at least 12 characters).
DESK_PASSWORD=
